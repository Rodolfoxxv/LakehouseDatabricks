{
  "datasets": [
    {
      "name": "ds_painel_operacional_dia",
      "displayName": "Painel Operacional Diário",
      "queryLines": [
        "SELECT data, nome_conjunto, qtd_interrupcoes, uc_horas_interrompidas, ",
        "       qtd_chamados, chamados_risco_saude, chamados_ouvidoria, ",
        "       ucs_prioridade_alta, acao_recomendada ",
        "FROM painel_operacional_dia ",
        "ORDER BY data ASC\n"
      ]
    },
    {
      "name": "ds_continuidade_metricas",
      "displayName": "Métricas de Continuidade",
      "queryLines": [
        "SELECT `Conjunto`, MEASURE(`DEC`) AS dec_horas ",
        "FROM continuidade_metricas ",
        "WHERE `Mes` = (SELECT MAX(mes_apuracao) FROM continuidade_conjunto_mes) ",
        "GROUP BY ALL ",
        "ORDER BY dec_horas DESC\n"
      ]
    },
    {
      "name": "ds_prioridade_inspecao",
      "displayName": "Prioridade de Inspeção por UC",
      "queryLines": [
        "SELECT id_uc, id_conjunto, nome_conjunto, bairro, classe_consumo, ",
        "       caiu_contra_si, vizinhanca_estavel, atende_os_dois_eixos, ",
        "       sinal_violacao_recente, variacao_da_uc, variacao_do_conjunto, ",
        "       prioridade_inspecao, motivo_observado ",
        "FROM prioridade_inspecao_uc\n"
      ]
    },
    {
      "name": "ds_saude_cliente",
      "displayName": "Saúde e Risco de Ouvidoria por Cliente",
      "queryLines": [
        "SELECT id_cliente, nome_conjunto, bairro, qtd_chamados, ",
        "       qtd_mencoes_ouvidoria, qtd_chamados_risco_saude, ",
        "       risco_ouvidoria, motivo_predominante, ultima_fala ",
        "FROM saude_cliente ",
        "WHERE risco_ouvidoria = 'alto' OR risco_ouvidoria = 'medio' ",
        "ORDER BY qtd_chamados DESC\n"
      ]
    }
  ],
